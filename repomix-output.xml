	_ = m
	// transición ilegal dentro del turno: no debe quedar ni el mensaje
	_, err = CerrarTurnoAgente(db, s.ID, "otra", -1, -1, -1, "", StatusTerminada) // inactiva->terminada es ilegal
	if !errors.Is(err, ErrEstadoIlegal) {
