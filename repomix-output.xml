	}
	if h[0].InputTokens != 820 || h[0].OutputTokens != 140 {
		t.Errorf("tokens: %+v", h[0])
	}
	if h[0].DurationMS != 1234 {
		t.Errorf("duración = %d, queremos 1234", h[0].DurationMS)
