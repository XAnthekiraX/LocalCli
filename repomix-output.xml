	}
	primerBuild, primeraAprobacion := -1, -1
	for i, paso := range traza {
		if paso == "agente:"+tools.AgenteBuild && primerBuild < 0 {
			primerBuild = i
		}
		if paso == "aprobado" && primeraAprobacion < 0 {
			primeraAprobacion = i
		}
	}
