	ses, err := CrearSesion(db, "s", "")
	if err != nil {
		t.Fatal(err)
	}
	if err := ReemplazarTodos(db, ses.ID, []Todo{{Contenido: "x", Estado: "pendiente"}}); err != nil {
		t.Fatal(err)
	}
	if err := BorrarSesion(db, ses.ID); err != nil {
		t.Fatal(err)
