	if strings.Contains(v, "Proyecto") {
		t.Errorf("el pie no rotula la firma del harness:\n%s", v)
	}
	if !strings.Contains(v, Nombre+" · "+Version) {
		t.Errorf("el pie muestra el nombre y la versión del harness:\n%s", v)
