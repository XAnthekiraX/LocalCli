		Estado:             session.EstadoTrabajando,
		ContextoTokens:     1234,
		TokensEstimados:    true,
		LimiteTokens:       2000,
		ElementoActual:     "T-B014",
		ElementosRestantes: 3,
		Ruta:               "/tmp/proyecto",
		GitRama:            "master",
		Capa:               "backend",
