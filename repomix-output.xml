func TestLaBienvenidaEditaEnCualquierPunto(t *testing.T) {
	a := Nuevo(&puertoStub{})
	pulsa(t, a, tea.WindowSizeMsg{Width: 100, Height: 30})
	escribe(t, a, "hole como estas")

	// Retroceder seis caracteres y escribir en medio.
