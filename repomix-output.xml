	if !errors.Is(err, fallo) {
		t.Fatalf("err = %v, queremos el error del paso anterior", err)
	}
	hist, err := HistorialDeArchivo(db, "a.go")
	if err != nil {
		t.Fatal(err)
	}
	if len(hist) != 0 {
		t.Errorf("quedó historial pese al fallo: %d filas", len(hist))
	}
