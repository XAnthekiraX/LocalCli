	var n int
	db.QueryRow("SELECT COUNT(*) FROM messages WHERE session_id = ? AND content = 'otra'", s.ID).Scan(&n)
	if n != 0 {
		t.Error("el mensaje quedó pese al rechazo de la transición (rollback ausente)")
	}
