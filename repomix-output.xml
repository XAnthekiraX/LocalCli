	if a.Init() == nil {
		t.Error("Init arma la escucha del canal de eventos")
	}
	if a.Vista != VistaBienvenida {
		t.Fatal("la primera vista es la bienvenida (SPEC-INTERFAZ)")
	}
	pulsa(t, a, tea.WindowSizeMsg{Width: 100, Height: 30})
	if v := a.View(); v == "" {
